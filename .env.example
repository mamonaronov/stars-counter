# Telegram
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Суперадмин: может всё, назначает главных админов. ID можно узнать у @userinfobot
SUPERADMIN_TELEGRAM_ID=123456789

# Часовой пояс для дат занятий и журнала
TIMEZONE=Europe/Moscow
# Заголовок Excel-отчёта
ORG_TITLE=Посещаемость групп

# Пути внутри контейнера
DB_PATH=/app/data/database.sqlite3
BACKUP_PATH=/app/backups
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=14
# Как часто проверять и присылать архив в группу бэкапов, минут (0 — выкл).
# По умолчанию раз в час. Если с прошлой отправки данные не менялись, архив не шлётся.
# Старое имя TELEGRAM_BACKUP_INTERVAL_HOURS ещё читается, если минуты не заданы.
TELEGRAM_BACKUP_INTERVAL_MINUTES=60

# Группа отмечающих: сюда бот присылает Excel с посещаемостью.
# ID группы (отрицательный). Пусто — задать командой /bindgroup в самой группе.
# Бот должен состоять в группе, уметь писать и закреплять сообщения.
MARKERS_GROUP_ID=
# Как часто проверять изменения и обновлять таблицу, минут (0 — только вручную и по /bindgroup)
MARKERS_EXPORT_INTERVAL_MINUTES=10

# Логи
LOG_LEVEL=INFO

# SOCKS5 для Telegram API (socks5h = DNS через прокси). Пусто, если Telegram доступен напрямую.
# Docker + mihomo-proxy (сеть telegram-proxy): socks5h://proxy:11808
TELEGRAM_PROXY_URL=
