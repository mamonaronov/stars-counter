# Installed by ./deploy.sh (WorkingDirectory and compose files are rewritten to the repo path).
# Manual:
#   sudo cp deploy/stars-counter.service /etc/systemd/system/stars-counter.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now stars-counter.service

[Unit]
Description=Stars Counter attendance Telegram bot
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/stars-counter
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=0
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
